<Window x:Class="Kaigorodov_TRPO_PR4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kaigorodov_TRPO_PR4"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="700">

    <Window.Resources>
        <local:Book x:Key="CurrentBook"/>
    </Window.Resources>
    <Window.DataContext>
        <Binding Source="{StaticResource CurrentBook}"/>
    </Window.DataContext>
    
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="ID: " VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id}" VerticalAlignment="Center"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Название книги: " VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Автор: " VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Author}" VerticalAlignment="Center"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Год издания: " VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Year}" VerticalAlignment="Center"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Количество страниц: " VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Page}" VerticalAlignment="Center"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Возраст книги: " VerticalAlignment="Center"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Age}" VerticalAlignment="Center"/>


        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Content="Сохранить" Width="120" Margin="0 0 10 0" Click="Save_Click"/>
            <Button Content="Новая запись" Width="120" Click="New_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Label Content="Поиск по ID: " VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Width="60" Margin="5"/>
            <Button Content="Найти" Width="93" Click="Find_Click" Margin="5"/>
        </StackPanel>

        <Button Content="Сбросить Объект"  Click="ResetBook" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
